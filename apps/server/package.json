{
  "name": "@diplomna-robota/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "lint": "echo 'lint: no-op (see apps/server/CLAUDE.md)'",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "neverthrow": "^8.2.0",
    "pino": "^9.13.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
